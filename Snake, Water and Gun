import random

def Game_win(user,computer):
    if user == computer:
        return None
    #For Snake and Gun:
    if user == "g" and computer == "s":
        return True
    if user == "s" and computer == "g":
        return False
    
    #For Water and Gun:
    if user == "w" and computer == "g":
        return True
    if user == "g" and computer == "w":
        return False
    
    #For Water and Snake:
    if user == "s" and computer == "w":
        return True
    if user == "w" and computer == "s":
        return False
    
rand_no = random.randint(1,3)

print("Computer's Turn:")
if rand_no == 1:
    computer = "s"
elif rand_no == 2:
    computer = "w"
else:
    computer = "g"

user = input("Your Turn: ").lower()

result = Game_win(user,computer)
print(f"\nYou chose: {user}")
print(f"Computer chose: {computer}")

if result is None:
    print("Draw!!!")
elif (result):
    print("You Win!!!")
else:
    print("You Lose!!!")
